# 约束 UART1 TX (对应原理图 B35_IO25)
set_property PACKAGE_PIN J15 [get_ports uart1_txd]
set_property IOSTANDARD LVCMOS33 [get_ports uart1_txd]

# 约束 UART1 RX (对应原理图 B34_IO25)
set_property PACKAGE_PIN T19 [get_ports uart1_rxd]
set_property IOSTANDARD LVCMOS33 [get_ports uart1_rxd]


